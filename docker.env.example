# Секреты Docker-версии AstanaTechCup (см. BACKUP.md).
#   cp docker.env.example docker.env
# docker.env в git не попадает. Значения — те же, что в Vercel → Settings →
# Environment Variables. Адрес базы задавать НЕ нужно: он прописан в compose.yaml.

# ⚠ ENCRYPTION_KEY — ровно тот же, что в Vercel. С другим ключом персональные
# данные из восстановленной копии прочитать невозможно.
ENCRYPTION_KEY=
CSRF_SECRET=

# Входы в /admin и /judge (npm run admin:hash).
ADMIN_PASSWORD_HASH=
JUDGE_PASSWORD_HASH=

# Необязательно: Turnstile, Stripe.
TURNSTILE_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
