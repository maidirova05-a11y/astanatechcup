####################################################################
# AstanaTechCup — environment
#
# Copy to `.env.local` and fill in. `.env.local` is git-ignored.
# NEVER commit real values. Every variable is validated at startup by
# src/lib/env.ts — a typo fails the boot instead of silently disabling
# a security control.
#
# The site runs with this file entirely empty: no database, no
# payments, no captcha. Production boot is blocked until the three
# variables marked REQUIRED IN PRODUCTION are set.
####################################################################

# ── Core ──────────────────────────────────────────────────────────

# Canonical public origin. No trailing slash.
# REQUIRED IN PRODUCTION, and must be https://
APP_URL=http://localhost:3000

# HMAC key for CSRF and form-timestamp tokens. REQUIRED IN PRODUCTION.
# Generate with: npm run keygen
CSRF_SECRET=

# ── Encryption ────────────────────────────────────────────────────────

# 32-byte AES-256 key, base64. REQUIRED IN PRODUCTION.
# Encrypts personal data at rest: the member roster, contact name, email,
# phone and comment. A stolen database backup is ciphertext without it.
#
# Generate with: npm run keygen
#
#   ⚠⚠ BACK THIS UP SOMEWHERE THAT IS NOT THE DATABASE AND NOT THIS REPO.
#      Lose it and every registration becomes permanently unreadable —
#      that is precisely what it is for, so there is no recovery path.
#      Change it and existing rows stop decrypting; rotation needs a
#      re-encryption pass (the `v1.` envelope prefix exists for that).
ENCRYPTION_KEY=

# ── Database ──────────────────────────────────────────────────────

# Postgres. REQUIRED IN PRODUCTION — without it, applications are held
# in memory and lost on restart.
#
# ⚠ DATA RESIDENCY: this database holds names and ages of minors who are
# citizens of Kazakhstan. KZ law No. 94-V requires such data to be stored
# on a database physically located in Kazakhstan. The organiser has chosen
# a self-hosted Postgres in KZ; put its connection string here.
#
# Format: postgres://user:password@host:5432/database?sslmode=require
DATABASE_URL=

# ── Admin panel ───────────────────────────────────────────────────────

# scrypt hash of the shared admin password. Generate it yourself:
#
#   npm run admin:hash
#
# The prompt is hidden and the plaintext never touches disk, argv or your
# shell history. Paste the value exactly as printed, with NO quotes around it.
#
# Without this (or without DATABASE_URL) /admin returns 404 rather than a
# login page, so a scanner cannot tell the panel exists.
ADMIN_PASSWORD_HASH=

# scrypt hash of the shared JUDGES' password, generated the same way:
#
#   npm run admin:hash
#
# It opens /judge — the scoring console the referee crew files match sheets and
# attempt times from — and NOTHING else. No applications, no personal data, no
# export. An admin session can reach the console too; a judge session can never
# reach the admin panel.
#
# ⚠ Make this a DIFFERENT password from ADMIN_PASSWORD_HASH. The whole point of
# the split is that a password shared with twenty referees standing at a venue
# is a password that gets overheard, and it must not be the one that opens the
# panel holding children's names and ages.
#
# Without it there is no separate judges' sign-in and only the organising
# committee can file results. Without it AND without ADMIN_PASSWORD_HASH,
# /judge returns 404 and the public results page says it is not connected.
JUDGE_PASSWORD_HASH=

# ── Bot protection (optional) ─────────────────────────────────────

# Cloudflare Turnstile. Both halves required or the feature stays off;
# the honeypot and timing checks run regardless.
# https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Payments (optional) ───────────────────────────────────────────

# Stripe hosted Checkout. This app NEVER handles card data — the payer
# is redirected to Stripe's own page, which keeps us in PCI SAQ A.
#
# For Kazakh acquiring (Kaspi / ePay / RoboKassa), add an adapter in
# src/lib/payments/ satisfying the same interface. Nothing outside that
# folder needs to change.
STRIPE_SECRET_KEY=

# Webhook signing secret. Without it the webhook endpoint returns 503
# and applications stay in `pending_payment` — which is the safe
# failure, because an unverified webhook must never mark anything paid.
STRIPE_WEBHOOK_SECRET=

# ── Infrastructure ────────────────────────────────────────────────

# Header carrying the real client IP, set by YOUR proxy.
#   Vercel      → x-vercel-forwarded-for
#   Cloudflare  → cf-connecting-ip
#   nginx       → whatever you configure
# Getting this wrong either rate-limits every visitor as one IP, or
# lets an attacker bypass limits by forging the header.
TRUSTED_IP_HEADER=x-forwarded-for

# ── Analytics (optional) ──────────────────────────────────────────

# Nothing loads unless BOTH are set, and then only after the visitor
# explicitly consents. Intended for a cookieless product (Plausible).
NEXT_PUBLIC_ANALYTICS_DOMAIN=
NEXT_PUBLIC_ANALYTICS_SRC=

# ── CSP rollout ───────────────────────────────────────────────────

# Set to 1 to send violations to /api/csp-report instead of enforcing.
# Run report-only for a few days after any change to third-party
# scripts, read the logs, then switch back to 0.
CSP_REPORT_ONLY=0
